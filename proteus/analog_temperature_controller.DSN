; Proteus Design Placeholder File
; Project: Analog Temperature Controller (Pure Analog)
; Note: This repository stores a text-based DSN handoff template.
; Import/recreate in Proteus ISIS using the exact netlist and references below.

[PROJECT]
NAME=analog_temperature_controller
VERSION=1.0
SUPPLY=12V

[NETS]
+12V
GND
VSENSE
VREF
VREF_RAW
COOL_CMD
HEAT_CMD
FAN1_GATE
FAN2_GATE
HEAT_GATE

[COMPONENTS]
U1=LM393
TH1=NTC_10K_B3950
RV1=POT_10K_LINEAR
Q1=IRF540N
Q2=IRF540N
Q3=IRF540N
M1=DC_FAN_12V
M2=DC_FAN_12V
RH1=RES_6R_HEATER
D1=1N4007
D2=1N4007
D3=1N4007
R1=10K
R2=68K
R3=68K
R4=10K
R5=10K
R6=100R
R7=100R
R8=100R
R9=10K
R10=10K
R11=10K
C1=10NF
C2=10NF
C3=100NF

[CONNECTIONS]
TH1.1=+12V
TH1.2=VSENSE
R1.1=VSENSE
R1.2=GND
C1.1=VSENSE
C1.2=GND

RV1.1=+12V
RV1.2=GND
RV1.W=VREF_RAW
R2.1=VREF_RAW
R2.2=VREF
R3.1=VREF
R3.2=GND
C2.1=VREF
C2.2=GND

U1.VCC=+12V
U1.GND=GND
C3.1=+12V
C3.2=GND

U1A.INP=VREF
U1A.INN=VSENSE
U1A.OUT=COOL_CMD
R4.1=COOL_CMD
R4.2=+12V

U1B.INP=VSENSE
U1B.INN=VREF
U1B.OUT=HEAT_CMD
R5.1=HEAT_CMD
R5.2=+12V

R6.1=COOL_CMD
R6.2=FAN1_GATE
Q1.G=FAN1_GATE
R9.1=FAN1_GATE
R9.2=GND
Q1.S=GND
Q1.D=M1_N
M1.+=+12V
M1.-=M1_N
D1.K=+12V
D1.A=M1_N

R7.1=COOL_CMD
R7.2=FAN2_GATE
Q2.G=FAN2_GATE
R10.1=FAN2_GATE
R10.2=GND
Q2.S=GND
Q2.D=M2_N
M2.+=+12V
M2.-=M2_N
D2.K=+12V
D2.A=M2_N

R8.1=HEAT_CMD
R8.2=HEAT_GATE
Q3.G=HEAT_GATE
R11.1=HEAT_GATE
R11.2=GND
Q3.S=GND
Q3.D=RH1_N
RH1.+=+12V
RH1.-=RH1_N
D3.K=+12V
D3.A=RH1_N
